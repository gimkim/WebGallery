{
  "ConnectionStrings": {
    "Gallery": "Data Source=App_Data/gallery-dev.db"
  },
  "Gallery": {
    "CachePath": "App_Data/cache",
    "DataProtectionKeysPath": "App_Data/keys",
    "DefaultRootPath": "App_Data/gallery-content",
    "ThumbnailConcurrency": 2,
    "DefaultItemsPerRow": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
