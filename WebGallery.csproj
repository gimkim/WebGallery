<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebGallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="backup\**" />
    <None Remove="backup\**" />
    <Content Remove="publish\**;publish-current\**;release\**" />
    <None Remove="publish\**;publish-current\**;release\**" />
    <Compile Remove="publish\**\*.cs;publish-current\**\*.cs;release\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="ThumbService\**\*.cs" />
    <Content Remove="ThumbService\**" />
    <None Remove="ThumbService\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebGalleryTargetPlatform)' == 'WindowsIIS'">
    <Content Update="appsettings.Docker.json" CopyToPublishDirectory="Never" />
    <None Update="deployment\INSTALL-WINDOWS11-IIS.txt" Link="INSTALL-WINDOWS11-IIS.txt" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebGalleryTargetPlatform)' == 'LinuxDocker'">
    <Content Update="web.config" CopyToPublishDirectory="Never" />
    <None Update="deployment\INSTALL-DOCKER-LINUX.md" Link="INSTALL-DOCKER-LINUX.md" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
