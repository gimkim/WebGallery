@model CollectionsIndexViewModel
@{
    ViewData["Title"] = "Collections";
    var createdLinkId = TempData.Peek("CreatedCollectionShareLinkId") is int id ? id : (int?)null;
    string ThumbnailUrl(string path, string cacheStamp) => Url.Action("Thumbnail", "Gallery", new
    {
        mode = "private",
        userName = Model.OwnerUserName,
        path,
        v = WebGallery.Services.ThumbnailService.CacheVersion,
        stamp = cacheStamp
    })!;
}

<section class="collection-heading">
    <div><div class="eyebrow">CURATED SHARING</div><h1>Collections</h1><p class="muted">Group folders from different locations and share them with one revocable link.</p></div>
    <a class="button" asp-controller="Gallery" asp-action="Index">Back to Gallery</a>
</section>

<section class="panel collection-density-toolbar">
    <label class="columns-control">Folders per row <input id="columns" type="range" min="2" max="10" value="@Model.DefaultItemsPerRow" /><output id="columns-value">@Model.DefaultItemsPerRow</output></label>
</section>

<section class="panel collection-create-panel">
    <form asp-action="Create" method="post">
        <label><span>New collection name</span><input name="name" maxlength="80" required placeholder="Example: Event highlights" /></label>
        <button class="primary" type="submit">Create collection</button>
    </form>
</section>

@if (Model.Collections.Count == 0)
{
    <section class="empty-state"><div class="empty-icon">◇</div><h2>No collections yet</h2><p>Create a collection first, then use its Add folders button to choose folder cards.</p></section>
}
else
{
    <div class="collection-list-controls" aria-label="Collection display controls">
        <button class="button compact" type="button" data-collections-expand-all>Expand all</button>
        <button class="button compact" type="button" data-collections-collapse-all>Collapse all</button>
    </div>
    <section class="collection-list">
    @foreach (var collection in Model.Collections)
    {
        var collectionBodyId = $"collection-body-{collection.Id}";
        var foldersBodyId = $"collection-folders-{collection.Id}";
        var shareLinksBodyId = $"collection-share-links-{collection.Id}";
        var forceExpanded = createdLinkId is not null && collection.ShareLinks.Any(share => share.Link.Id == createdLinkId.Value);
        <article class="panel collection-card" data-collection-collapsible data-collection-id="@collection.Id" data-folder-count="@collection.Folders.Count" data-force-expanded="@(forceExpanded ? "true" : "false")">
            <header>
                <button class="collection-card-heading-toggle" type="button" data-collection-toggle data-collection-name="@collection.Name" aria-controls="@collectionBodyId" aria-expanded="@(forceExpanded ? "true" : "false")">
                    <span class="collection-disclosure-icon" aria-hidden="true"></span>
                    <span class="collection-card-heading-copy">
                        <span class="collection-card-title" role="heading" aria-level="2">@collection.Name</span>
                        <span class="collection-card-badges">
                            <span class="collection-count-badge">@collection.Folders.Count folder@(collection.Folders.Count == 1 ? "" : "s")</span>
                            <span class="collection-count-badge">@collection.ShareLinks.Count link@(collection.ShareLinks.Count == 1 ? "" : "s")</span>
                        </span>
                    </span>
                </button>
                <div class="collection-card-actions">
                    <a class="button compact" asp-action="SelectFolders" asp-route-id="@collection.Id">Add folders</a>
                    <form asp-action="Delete" method="post" data-confirm="Delete this collection and revoke all of its links?"><input type="hidden" name="id" value="@collection.Id" /><button class="danger-text" type="submit">Delete collection</button></form>
                </div>
            </header>

            <div id="@collectionBodyId" class="collection-card-body" data-collection-body hidden="@(!forceExpanded)">
            <section class="collection-subsection collection-folders" data-collection-section data-collection-id="@collection.Id" data-section-key="folders" data-default-expanded="true">
                <button class="collection-section-toggle" type="button" data-section-toggle aria-controls="@foldersBodyId" aria-expanded="true">
                    <span class="collection-disclosure-icon" aria-hidden="true"></span>
                    <span class="collection-section-title">Folders</span>
                    <span class="collection-section-count">@collection.Folders.Count</span>
                </button>
                <div id="@foldersBodyId" class="collection-section-body" data-section-body>
                @if (collection.Folders.Count == 0)
                {
                    <div class="collection-section-empty">
                        <svg class="collection-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h6l2 2h10v10H3z"/><path d="M3 6.5v-2h7l2 2h9v2"/></svg>
                        <div><h3>No folders yet</h3><p>Choose folders from your gallery to include in this collection.</p></div>
                        <a class="button primary compact" asp-action="SelectFolders" asp-route-id="@collection.Id">Add folders</a>
                    </div>
                }
                else
                {
                    <div class="gallery-grid collection-folder-grid" data-default-columns="@Model.DefaultItemsPerRow" data-folder-count="@collection.Folders.Count" style="--columns:@Math.Min(Model.DefaultItemsPerRow, collection.Folders.Count)">
                    @foreach (var folder in collection.Folders)
                    {
                        var item = folder.Item;
                        var displayName = item?.Name ?? folder.RelativePath.Replace('\\', '/').Split('/').LastOrDefault() ?? folder.RelativePath;
                        <article class="gallery-card directory-card collection-folder-card @(item is null ? "collection-folder-unavailable" : "")" data-relative-path="@folder.RelativePath">
                            @if (item is not null)
                            {
                                <a class="collection-folder-card-link" asp-controller="Gallery" asp-action="Index" asp-route-path="@folder.RelativePath" aria-label="Open @displayName"></a>
                            }
                            <form class="collection-folder-remove" asp-action="RemoveFolder" method="post">
                                <input type="hidden" name="id" value="@folder.MembershipId" />
                                <button class="danger-text" type="submit" aria-label="Remove @displayName from @collection.Name" title="Remove from collection">Remove</button>
                            </form>
                            @if (item?.CoverImages.Count > 0)
                            {
                                <div class="media folder-media folder-cover">
                                    <div class="folder-cover-shell">
                                        <span class="folder-cover-tab" aria-hidden="true"></span>
                                        <div class="folder-cover-grid cover-count-@item.CoverImages.Count">
                                            @foreach (var cover in item.CoverImages)
                                            {
                                                <span class="thumbnail-slot thumbnail-loading"><img data-thumbnail-src="@ThumbnailUrl(cover.RelativePath, cover.CacheStamp)" alt="" decoding="async" /></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="media folder-media"><span class="folder-shape"></span></div>
                            }
                            <div class="item-info">
                                <strong title="@displayName">@displayName</strong>
                                <small class="collection-folder-path" title="@folder.RelativePath">@folder.RelativePath</small>
                                <small>@(item is null ? "Unavailable" : "Folder")</small>
                            </div>
                        </article>
                    }
                    </div>
                }
                </div>
            </section>

            <section class="collection-subsection collection-share-block" data-collection-section data-collection-id="@collection.Id" data-section-key="share-links" data-default-expanded="true" data-force-expanded="@(forceExpanded ? "true" : "false")">
                <button class="collection-section-toggle" type="button" data-section-toggle aria-controls="@shareLinksBodyId" aria-expanded="true">
                    <span class="collection-disclosure-icon" aria-hidden="true"></span>
                    <span class="collection-section-title">Share links</span>
                    <span class="collection-section-count">@collection.ShareLinks.Count</span>
                </button>
                <div id="@shareLinksBodyId" class="collection-section-body collection-share-content" data-section-body>
                @if (collection.ShareLinks.Count == 0)
                {
                    <div class="collection-section-empty">
                        <svg class="collection-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 14.5l5-5"/><path d="M7.2 17.8l-1 1a3 3 0 01-4.2-4.2l4-4a3 3 0 014.2 0"/><path d="M16.8 6.2l1-1A3 3 0 0122 9.4l-4 4a3 3 0 01-4.2 0"/></svg>
                        <div><h3>No share links yet</h3><p>Create a revocable unlisted link for the folders in this collection.</p></div>
                        <form asp-action="CreateShare" method="post" class="collection-share-create" data-create-share>
                            <input type="hidden" name="collectionId" value="@collection.Id" />
                            <input type="hidden" name="itemsPerRow" value="@Model.DefaultItemsPerRow" />
                            <input type="hidden" name="viewMode" value="grid" />
                            <button class="primary compact" type="submit" disabled="@(collection.Folders.Count == 0)">Create share link</button>
                        </form>
                    </div>
                }
                else
                {
                    @foreach (var share in collection.ShareLinks)
                    {
                        var link = share.Link;
                        var linkUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Share", "Gallery", new { token = link.Token, sort = link.Sort, dir = link.Direction, itemsPerRow = link.ItemsPerRow, view = link.ViewMode })}";
                        var viewLabel = string.Equals(link.ViewMode, "list", StringComparison.OrdinalIgnoreCase) ? "List" : "Grid";
                        var sortLabel = link.Sort.ToLowerInvariant() switch { "size" => "Size", "date" => "Date", _ => "Name" };
                        var directionLabel = string.Equals(link.Direction, "desc", StringComparison.OrdinalIgnoreCase) ? "descending" : "ascending";
                        <div class="share-entry @(link.Id == createdLinkId ? "share-row-created" : "")">
                            <div class="share-row">
                                <input readonly value="@linkUrl" /><button type="button" data-copy="@linkUrl">Copy</button>
                                <a class="button compact" asp-action="ShareActivity" asp-route-id="@link.Id">Activity</a>
                                <form asp-action="RevokeShare" method="post"><input type="hidden" name="id" value="@link.Id" /><button class="danger-text" type="submit">Revoke</button></form>
                            </div>
                            <div class="share-link-details" aria-label="Saved share link settings">
                                <span>Created @link.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="share-setting-badge">@viewLabel</span>
                                <span class="share-setting-badge">Sort: @sortLabel @directionLabel</span>
                                <span class="share-setting-badge">@link.ItemsPerRow per row</span>
                            </div>
                            <div class="share-metrics" aria-label="Share activity summary">
                                <span><strong>@share.AccessCount</strong> accesses</span><span><strong>@share.ViewCount</strong> views</span><span><strong>@share.DownloadCount</strong> downloads</span><span><strong>@share.UniqueVisitorCount</strong> visitors</span>
                                <span class="share-last-activity">@(share.LastActivityUtc is null ? "No activity yet" : $"Last {share.LastActivityUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}")</span>
                            </div>
                        </div>
                    }
                    <form asp-action="CreateShare" method="post" class="collection-share-create" data-create-share>
                        <input type="hidden" name="collectionId" value="@collection.Id" />
                        <input type="hidden" name="itemsPerRow" value="@Model.DefaultItemsPerRow" />
                        <input type="hidden" name="viewMode" value="grid" />
                        <button class="primary" type="submit">Create another share link</button>
                    </form>
                }
                </div>
            </section>
            </div>
        </article>
    }
    </section>
}

<section class="panel folder-share-links-section" data-folder-shares-collapsible>
    <button class="folder-share-links-toggle" type="button" data-folder-shares-toggle aria-controls="folder-share-links-body" aria-expanded="true">
        <span class="collection-disclosure-icon" aria-hidden="true"></span>
        <span class="folder-share-links-title-copy">
            <span class="folder-share-links-title" role="heading" aria-level="2">Folder share links</span>
            <span class="folder-share-links-description">Active links created from individual Gallery folders.</span>
        </span>
        <span class="folder-share-links-badges">
            <span class="collection-count-badge">@Model.FolderShareGroups.Count folder@(Model.FolderShareGroups.Count == 1 ? "" : "s")</span>
            <span class="collection-count-badge">@Model.FolderShareLinkCount link@(Model.FolderShareLinkCount == 1 ? "" : "s")</span>
        </span>
    </button>
    <div id="folder-share-links-body" class="folder-share-links-body" data-folder-shares-body>
    @if (Model.FolderShareGroups.Count == 0)
    {
        <div class="collection-section-empty folder-share-empty">
            <svg class="collection-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 14.5l5-5"/><path d="M7.2 17.8l-1 1a3 3 0 01-4.2-4.2l4-4a3 3 0 014.2 0"/><path d="M16.8 6.2l1-1A3 3 0 0122 9.4l-4 4a3 3 0 01-4.2 0"/></svg>
            <div><h3>No folder share links</h3><p>Open a Gallery folder and use Share to create an unlisted link.</p></div>
            <a class="button compact" asp-controller="Gallery" asp-action="Index">Browse Gallery</a>
        </div>
    }
    else
    {
        <div class="folder-share-group-list">
        @foreach (var group in Model.FolderShareGroups)
        {
            var folderPath = group.RelativePath.Replace('\\', '/');
            <article class="folder-share-group @(group.Item is null ? "folder-share-group-unavailable" : "")">
                <div class="folder-share-group-preview">
                @if (group.Item is not null)
                {
                    <a class="folder-share-preview-link" asp-controller="Gallery" asp-action="Index" asp-route-path="@group.RelativePath" aria-label="Open @group.DisplayName"></a>
                }
                @if (group.Item?.CoverImages.Count > 0)
                {
                    <div class="media folder-media folder-cover" aria-hidden="true">
                        <div class="folder-cover-shell">
                            <span class="folder-cover-tab" aria-hidden="true"></span>
                            <div class="folder-cover-grid cover-count-@group.Item.CoverImages.Count">
                                @foreach (var cover in group.Item.CoverImages)
                                {
                                    <span class="thumbnail-slot thumbnail-loading"><img data-thumbnail-src="@ThumbnailUrl(cover.RelativePath, cover.CacheStamp)" alt="" decoding="async" /></span>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="media folder-media" aria-hidden="true"><span class="folder-shape"></span></div>
                }
                </div>
                <div class="folder-share-group-content">
                <header class="folder-share-group-heading">
                    <span class="folder-share-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6.5h6l2 2h10v10H3z"/><path d="M3 6.5v-2h7l2 2h9v2"/></svg></span>
                    <div class="folder-share-group-copy">
                        <h3>
                        @if (group.Item is not null)
                        {
                            <a asp-controller="Gallery" asp-action="Index" asp-route-path="@group.RelativePath">@group.DisplayName</a>
                        }
                        else
                        {
                            @group.DisplayName
                        }
                        </h3>
                        <p title="@folderPath">@(string.IsNullOrWhiteSpace(folderPath) ? "Gallery home" : folderPath)</p>
                    </div>
                    <span class="collection-count-badge">@group.ShareLinks.Count link@(group.ShareLinks.Count == 1 ? "" : "s")</span>
                    @if (group.Item is not null)
                    {
                        <a class="button compact" asp-controller="Gallery" asp-action="Index" asp-route-path="@group.RelativePath">Open folder</a>
                    }
                    else
                    {
                        <span class="share-setting-badge">Unavailable</span>
                    }
                </header>
                <div class="folder-share-group-links">
                @foreach (var share in group.ShareLinks)
                {
                    var link = share.Link;
                    var linkUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Share", "Gallery", new { token = link.Token, sort = link.Sort, dir = link.Direction, itemsPerRow = link.ItemsPerRow, view = link.ViewMode })}";
                    var viewLabel = string.Equals(link.ViewMode, "list", StringComparison.OrdinalIgnoreCase) ? "List" : "Grid";
                    var sortLabel = link.Sort.ToLowerInvariant() switch { "size" => "Size", "date" => "Date", _ => "Name" };
                    var directionLabel = string.Equals(link.Direction, "desc", StringComparison.OrdinalIgnoreCase) ? "descending" : "ascending";
                    <article class="share-entry folder-share-entry">
                        <div class="folder-share-link-heading">
                            <strong>Created @link.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                            <div class="share-link-details" aria-label="Saved share link settings">
                                <span class="share-setting-badge">@viewLabel</span>
                                <span class="share-setting-badge">Sort: @sortLabel @directionLabel</span>
                                <span class="share-setting-badge">@link.ItemsPerRow per row</span>
                            </div>
                        </div>
                        <div class="share-row folder-share-url-row">
                            <input readonly value="@linkUrl" aria-label="Share URL for @group.DisplayName" /><button type="button" data-copy="@linkUrl">Copy</button>
                            <a class="button compact" asp-action="ShareActivity" asp-route-id="@link.Id">Activity</a>
                            <form asp-action="RevokeShare" method="post"><input type="hidden" name="id" value="@link.Id" /><button class="danger-text" type="submit">Revoke</button></form>
                        </div>
                        <div class="share-metrics" aria-label="Share activity summary">
                            <span><strong>@share.AccessCount</strong> accesses</span><span><strong>@share.ViewCount</strong> views</span><span><strong>@share.DownloadCount</strong> downloads</span><span><strong>@share.UniqueVisitorCount</strong> visitors</span>
                            <span class="share-last-activity">@(share.LastActivityUtc is null ? "No activity yet" : $"Last {share.LastActivityUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}")</span>
                        </div>
                    </article>
                }
                </div>
                </div>
            </article>
        }
        </div>
    }
    </div>
</section>
