@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using WebGallery.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject GalleryDbContext GalleryDb
@inject IOptions<GalleryOptions> GalleryOptions
@{
    var appTitle = (await GalleryDb.AppSettings.FindAsync("AppTitle"))?.Value ?? GalleryOptions.Value.AppTitle;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - @appTitle</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="photo-gallery" data-app-base="@Context.Request.PathBase">
    <header class="topbar">
        <a class="brand" asp-controller="Gallery" asp-action="Index">
            <span class="brand-mark">G</span><span>@appTitle</span>
        </a>
        <nav class="topnav">
            @if (SignInManager.IsSignedIn(User))
            {
                <span class="user-chip">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button" type="submit">Sign out</button></form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            }
        </nav>
    </header>
    @if (SignInManager.IsSignedIn(User))
    {
        <nav class="library-nav" aria-label="Library">
            <span class="library-caption">LIBRARY</span>
            <a asp-controller="Gallery" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Gallery" ? "active" : "")"><span aria-hidden="true">▧</span> Photos</a>
            <a asp-controller="Collections" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Collections" ? "active" : "")"><span aria-hidden="true">▤</span> Collections</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"><span aria-hidden="true">⚙</span> Management</a>
            }
        </nav>
    }
    <main class="page-shell">
        @if (TempData["Success"] is string success) { <div class="alert success">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
        @RenderBody()
    </main>
    <script src="~/js/page-scope.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/video-player.js" asp-append-version="true"></script>
    <script src="~/js/gallery-stream.js" asp-append-version="true"></script>
    <script src="~/js/spa-router.js" asp-append-version="true"></script>
    <script src="~/js/file-operations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
