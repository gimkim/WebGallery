@model PasswordChangeViewModel
@{ ViewData["Title"] = "Change password"; }
<section class="auth-card panel">
    <h1>Change your password</h1><p>You must change your password before continuing.</p>
    <form method="post" class="stack-form">
        <div asp-validation-summary="All" class="validation"></div>
        <label>Current password<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required /></label>
        <label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" maxlength="256" required /></label>
        <label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /></label>
        <small>At least 10 characters, with uppercase, lowercase, a number and a symbol.</small>
        <button class="primary">Change password</button>
    </form>
</section>
