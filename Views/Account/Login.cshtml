@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth-card panel">
    <div class="eyebrow">PRIVATE GALLERY</div>
    <h1>Sign in</h1>
    <p class="muted">Use your account to open your private gallery.</p>
    @if (Model.RetryAfterSeconds is int retryAfterSeconds)
    {
        <div class="alert error cooldown-alert" role="status" data-cooldown="@retryAfterSeconds">
            <span>Too many sign-in attempts. Try again in</span>
            <strong data-cooldown-value>@retryAfterSeconds seconds</strong>
        </div>
    }
    <form method="post" class="stack-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label>Username<input asp-for="UserName" autocomplete="username" autofocus required /></label>
        <label>Password<input asp-for="Password" type="password" autocomplete="current-password" required /></label>
        <label class="check"><input asp-for="RememberMe" /> Remember me</label>
        <button class="primary" type="submit">Sign in</button>
    </form>
</section>
