@model AdminIndexViewModel
@{ ViewData["Title"] = "Management"; }
<section class="gallery-heading"><div><div class="eyebrow">MANAGEMENT</div><h1>System and users</h1><p class="muted">Manage site behavior, login protection, user accounts, and each user's root folder.</p></div></section>
<nav class="management-tabs" aria-label="Management sections"><a class="active" asp-action="Index">System and users</a><a asp-action="Logs">Logs</a></nav>

<section class="panel admin-section">
    <h2>System</h2>
    <form asp-action="SaveSettings" method="post" class="admin-grid-form">
        <label>Site title<input name="appTitle" value="@Model.AppTitle" required /></label>
        <label>Theme<select name="theme" required><option value="retro" selected="@(Model.Theme == "retro")">Retro</option><option value="modern" selected="@(Model.Theme == "modern")">Modern</option></select><small>Retro keeps the current pixel-style interface. Modern uses a softer contemporary interface.</small></label>
        <label>Concurrent thumbnail jobs<input name="thumbnailConcurrency" type="number" min="1" max="16" value="@Model.ThumbnailConcurrency" required /><small>Limits CPU-heavy thumbnail generation across the entire server. Recommended: 2–4.</small></label>
        <div class="admin-form-heading wide"><h3>Login protection</h3><p class="muted">Progressive delays apply by username. Cooldowns block repeated attempts by username and by direct client IP.</p></div>
        <label>Start delay after<input name="loginDelayAfterFailures" type="number" min="1" max="99" value="@Model.LoginDelayAfterFailures" required /><small>Failed attempts before a short progressive delay begins. Must be lower than the username cooldown threshold.</small></label>
        <label>Delay increment (seconds)<input name="loginDelayIncrementSeconds" type="number" min="0" max="300" value="@Model.LoginDelayIncrementSeconds" required /><small>Added to the next retry delay after each further failure. Set to 0 to disable progressive delay.</small></label>
        <label>Username cooldown after<input name="loginUserFailureLimit" type="number" min="2" max="100" value="@Model.LoginUserFailureLimit" required /><small>Failed attempts for the same normalized username before cooldown.</small></label>
        <label>Username cooldown (minutes)<input name="loginUserCooldownMinutes" type="number" min="1" max="1440" value="@Model.LoginUserCooldownMinutes" required /><small>Also persists real-account lockout in SQLite across application restarts.</small></label>
        <label>IP cooldown after<input name="loginIpFailureLimit" type="number" min="2" max="100" value="@Model.LoginIpFailureLimit" required /><small>Total failed attempts from one direct client IP before cooldown.</small></label>
        <label>IP cooldown (minutes)<input name="loginIpCooldownMinutes" type="number" min="1" max="1440" value="@Model.LoginIpCooldownMinutes" required /><small>Slows password spraying across multiple usernames from the same IP.</small></label>
        <button class="primary" type="submit">Save</button>
    </form>
</section>

<section class="panel admin-section">
    <h2>Create user</h2>
    <form asp-action="CreateUser" method="post" class="admin-grid-form">
        <label>Username<input name="userName" required /></label>
        <label>Display name<input name="displayName" required /></label>
        <label class="wide">Root folder<input name="rootFolder" placeholder="D:\Photos\Somchai" required /></label>
        <label>Password<input name="password" type="password" minlength="10" required /></label>
        <label class="check"><input name="isAdmin" type="checkbox" value="true" /> Admin</label>
        <button class="primary" type="submit">Create user</button>
    </form>
</section>

<section class="admin-users">
    @foreach (var user in Model.Users)
    {
        <article class="panel user-card">
            <div class="user-title"><div class="avatar">@user.UserName[..1].ToUpperInvariant()</div><div><h2>@user.UserName</h2><small>@(user.IsAdmin ? "Administrator" : "User")</small></div></div>
            <form asp-action="UpdateUser" method="post" class="stack-form">
                <input type="hidden" name="id" value="@user.Id" />
                <label>Display name<input name="displayName" value="@user.DisplayName" required /></label>
                <label>Root folder<input name="rootFolder" value="@user.RootFolder" required /></label>
                <label>New password<input name="newPassword" type="password" minlength="10" placeholder="Leave blank to keep the current password" /></label>
                <label class="check"><input name="isAdmin" type="checkbox" value="true" checked="@user.IsAdmin" /> Admin</label>
                <button class="primary" type="submit">Save</button>
            </form>
            <form asp-action="DeleteUser" method="post" data-confirm="Delete @user.UserName? Files will not be deleted."><input type="hidden" name="id" value="@user.Id" /><button class="danger-text" type="submit">Delete account</button></form>
        </article>
    }
</section>
