# Copy this file outside the repository as webgallery.env and edit every path.
WEBGALLERY_DATA_ROOT=/volume1/docker/webgallery
WEBGALLERY_MEDIA_ROOT_1=/volume1/photos
WEBGALLERY_MEDIA_ROOT_2=/volume2/videos
# Set false to enable create/upload/move; grant the container UID write access
# only to intended media folders. Each account selects one mounted root.
WEBGALLERY_MEDIA_READ_ONLY=true
WEBGALLERY_BIND_IP=127.0.0.1
WEBGALLERY_PORT=8080
WEBGALLERY_TIMEZONE=Asia/Bangkok

# Leave false for direct private HTTP access. For a public HTTPS reverse proxy,
# enable it and set the exact proxy address (or CIDR) plus the public host.
WEBGALLERY_PROXY_ENABLED=false
WEBGALLERY_PROXY_FORWARD_LIMIT=1
WEBGALLERY_PROXY_IP=
WEBGALLERY_PROXY_NETWORK=
WEBGALLERY_PUBLIC_HOST=
WEBGALLERY_HTTPS_REDIRECT=false

# Only required with compose.intel-qsv.yaml. Obtain it on the host with:
# stat -c '%g' /dev/dri/renderD128
WEBGALLERY_RENDER_GID=109
